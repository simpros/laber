{
  "name": "laber",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@happy-dom/global-registrator": "^20.14.6",
      "@types/bun": "1.4.4",
      "happy-dom": "^20.14.6",
      "typescript": "5.9.3"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts/ && bun scripts/check-toolchain-version.ts",
    "check": "turbo run check && tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "deps:orphans": "bun scripts/check-orphan-workspaces.ts",
    "test": "turbo run test && bun test scripts/",
    "test:e2e": "turbo run test:e2e",
    "auth:generate": "turbo run auth:generate"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@laber/eslint-config": "workspace:*",
    "@types/bun": "catalog:",
    "eslint": "10.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "0.8.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "dependencies": {},
  "patchedDependencies": {
    "playwright@1.58.2": "patches/playwright@1.58.2.patch",
    "ssh2@1.17.0": "patches/ssh2@1.17.0.patch"
  }
}
