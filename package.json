{
  "name": "laber",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/bun": "^1.4.4"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts/",
    "check": "turbo run check && tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "deps:orphans": "bun scripts/check-orphan-workspaces.ts",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "auth:generate": "turbo run auth:generate"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@happy-dom/global-registrator": "^20.14.6",
    "@laber/eslint-config": "workspace:*",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "catalog:",
    "eslint": "10.3.0",
    "eslint-plugin-svelte": "^3.23.1",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^3.5.2",
    "prettier-plugin-tailwindcss": "0.8.0",
    "svelte": "^5.57.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {},
  "patchedDependencies": {
    "playwright@1.58.2": "patches/playwright@1.58.2.patch",
    "ssh2@1.17.0": "patches/ssh2@1.17.0.patch"
  }
}
