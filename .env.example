# SQLite only — no external database service.
# Database file path (defaults to <DATA_DIR>/laber.db when unset).
DATABASE_PATH=./data/laber.db

# Data directory for cloned repositories and the SQLite file.
DATA_DIR=./data

# Auth
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret
# Dev (vite on :5173) by default; prod compose defaults to http://localhost:3000.
BETTER_AUTH_BASE_URL=http://localhost:5173

# API port (apps/server, defaults to 3001).
PORT=3001

# Where the web dev/preview server proxies /api/* (defaults to http://localhost:3001).
LABER_API_URL=http://localhost:3001
